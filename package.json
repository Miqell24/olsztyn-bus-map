{
  "name": "olsztyn-bus-map",
  "version": "0.1.0",
  "type": "module",
  "private": true,
  "description": "Interactive map of Olsztyn public transport (33 bus + 5 tram lines) — ZDZiT GTFS + OSM + HMM map matching",
  "scripts": {
    "download": "bash pipeline/download.sh",
    "build": "node --max-old-space-size=4096 pipeline/build.mjs --all --tram all",
    "lines": "node --max-old-space-size=4096 pipeline/lines.mjs",
    "report": "node pipeline/report-gaps.mjs",
    "audit": "node --max-old-space-size=4096 pipeline/audit.mjs",
    "serve": "node pipeline/serve.mjs 8171"
  }
}
